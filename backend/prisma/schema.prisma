// Prisma Schema
// Database schema for Fotoalbum App

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  username         String    @unique
  name             String?
  color            String?
  avatar           String?
  displayNameField String?   @default("name") // "name" oder "username"
  role             String    @default("user") // "user" oder "admin"
  migratedFrom     String?
  migratedAt       DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  auth_source      String? // "authentik", "google", "plex", "github" etc.

  groups                        GroupMember[]
  photos                        Photo[]
  comments                      Comment[]
  likes                         Like[]
  albumContributions            AlbumContributor[]
  groupDeputies                 GroupDeputy[]
  blockedInGroups               GroupBlock[]              @relation("BlockedUser")
  blockedByInGroups             GroupBlock[]              @relation("BlockedByUser")
  notifications                 Notification[]
  notifPreference               NotificationPreference?
  feedbackReports               FeedbackReport[]
  reportedInFeedback            FeedbackReport[]          @relation("ReportedUser")
  feedbackMessages              FeedbackMessage[]
  createdInvites                GroupInvite[]             @relation("GroupInviteCreator")
  exports                       UserExport[]
  accountDeletionRequest        AccountDeletionRequest?
  adminActionLogs               AdminActionLog[]
  blockedLoginIdentitiesCreated BlockedLoginIdentity[]    @relation("BlockedLoginIdentityBlockedBy")
  feedPosts                     GroupFeedPost[]
  savedFeedPosts                GroupFeedPostSave[]
  feedPostHistoryEntries        GroupFeedPostHistory[]    @relation("GroupFeedPostHistoryEditor")
  likedFeedPosts                GroupFeedPostLike[]
  feedComments                  GroupFeedComment[]
  feedCommentHistoryEntries     GroupFeedCommentHistory[] @relation("GroupFeedCommentHistoryEditor")
  likedFeedComments             GroupFeedCommentLike[]
  feedCommentsDeleted           GroupFeedComment[]        @relation("GroupFeedCommentDeletedBy")
  tournamentPresetsCreated      TournamentPreset[]        @relation("TournamentPresetCreator")
  tournamentInstancesCreated    TournamentInstance[]      @relation("TournamentInstanceCreator")
  tournamentInstancesStarted    TournamentInstance[]      @relation("TournamentInstanceStartedBy")
  tournamentInstancesEnded      TournamentInstance[]      @relation("TournamentInstanceEndedBy")
  tournamentInstancesCancelled  TournamentInstance[]      @relation("TournamentInstanceCancelledBy")
  tournamentParticipants        TournamentParticipant[]   @relation("TournamentParticipantUser")
  tournamentTeamsCreated        TournamentTeam[]          @relation("TournamentTeamCreator")
  tournamentMatchesRecorded     TournamentMatch[]         @relation("TournamentMatchRecordedBy")
}

model Group {
  id                                String   @id @default(cuid())
  name                              String
  code                              String   @unique
  createdBy                         String?
  inviteCodeVisibleToMembers        Boolean  @default(true)
  uploadsRestrictedToModerators     Boolean  @default(false)
  albumsRestrictedToModerators      Boolean  @default(false)
  feedPostingRestrictedToModerators Boolean  @default(false)
  maxMembers                        Int?
  memberLimitLocked                 Boolean  @default(false)
  createdAt                         DateTime @default(now())

  members             GroupMember[]
  albums              Album[]
  photos              Photo[]
  deputies            GroupDeputy[]
  blocks              GroupBlock[]
  invites             GroupInviteGroup[]
  feedPosts           GroupFeedPost[]
  feedComments        GroupFeedComment[]
  tournamentPresets   TournamentPreset[]
  tournamentInstances TournamentInstance[]
}

model TournamentPreset {
  id                 String   @id @default(cuid())
  groupId            String
  name               String
  description        String?
  baseType           String   @default("single_elimination") // single_elimination | double_elimination | round_robin | group_plus_knockout | custom
  participantMode    String   @default("team") // individual | team | pair
  minParticipants    Int      @default(2)
  maxParticipants    Int      @default(128)
  defaultMatchBestOf Int      @default(1)
  config             Json?
  isArchived         Boolean  @default(false)
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group     Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator   User                    @relation("TournamentPresetCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  stages    TournamentPresetStage[]
  instances TournamentInstance[]

  @@unique([groupId, name])
  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
  @@map("tournament_presets")
}

model TournamentPresetStage {
  id         String   @id @default(cuid())
  presetId   String
  stageOrder Int
  name       String
  stageType  String   @default("single_elimination") // single_elimination | double_elimination | round_robin
  config     Json?
  createdAt  DateTime @default(now())

  preset TournamentPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, stageOrder])
  @@index([presetId, stageOrder])
  @@map("tournament_preset_stages")
}

model TournamentInstance {
  id              String    @id @default(cuid())
  presetId        String
  groupId         String
  name            String
  status          String    @default("draft") // draft | registration | scheduled | in_progress | completed | cancelled
  config          Json?
  startAt         DateTime?
  endAt           DateTime?
  createdBy       String
  startedBy       String?
  endedBy         String?
  cancelledBy     String?
  cancelledReason String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  preset       TournamentPreset        @relation(fields: [presetId], references: [id], onDelete: Restrict)
  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator      User                    @relation("TournamentInstanceCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  starter      User?                   @relation("TournamentInstanceStartedBy", fields: [startedBy], references: [id], onDelete: SetNull)
  ender        User?                   @relation("TournamentInstanceEndedBy", fields: [endedBy], references: [id], onDelete: SetNull)
  canceller    User?                   @relation("TournamentInstanceCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  teams        TournamentTeam[]
  participants TournamentParticipant[]
  rounds       TournamentRound[]
  matches      TournamentMatch[]

  @@unique([groupId, name])
  @@index([groupId, status, createdAt(sort: Desc)])
  @@index([presetId, createdAt(sort: Desc)])
  @@index([status, startAt(sort: Desc)])
  @@map("tournament_instances")
}

model TournamentTeam {
  id         String   @id @default(cuid())
  instanceId String
  name       String
  seed       Int?
  metadata   Json?
  createdBy  String?
  createdAt  DateTime @default(now())

  // Stats (im team/pair-Modus gehören diese aufs Team, nicht auf einen Stellvertreter-Participant)
  points Int @default(0)
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)

  instance     TournamentInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  creator      User?                   @relation("TournamentTeamCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants TournamentParticipant[]
  homeMatches  TournamentMatch[]       @relation("TournamentMatchHomeTeam")
  awayMatches  TournamentMatch[]       @relation("TournamentMatchAwayTeam")
  wonMatches   TournamentMatch[]       @relation("TournamentMatchWinnerTeam")
  matchResults TournamentMatchResult[]

  @@unique([instanceId, name])
  @@index([instanceId, seed])
  @@index([createdBy])
  @@map("tournament_teams")
}

model TournamentParticipant {
  id           String    @id @default(cuid())
  instanceId   String
  // Optional: ein Teilnehmer kann ein "Ghost" sein (z. B. ein Team ohne zugeordneten User).
  // In `team`/`pair`-Modus bleibt userId optional, in `individual`-Modus erzwingt der Endpoint einen Wert.
  userId       String?
  // Snapshot des Anzeigenamens. Wird beim Anlegen gesetzt (User-Name oder Team-Name) und
  // beim späteren Zuordnen eines Users aktualisiert. Wird in Matches/Standings angezeigt.
  displayName  String?
  teamId       String?
  seed         Int?
  status       String    @default("registered") // registered | checked_in | active | eliminated | withdrawn
  points       Int       @default(0)
  wins         Int       @default(0)
  losses       Int       @default(0)
  draws        Int       @default(0)
  eliminatedAt DateTime?
  // Zeitpunkt der letzten User-Zuordnung. null = noch Ghost (kein User zugeordnet).
  assignedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  instance     TournamentInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user         User?                   @relation("TournamentParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  team         TournamentTeam?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  homeMatches  TournamentMatch[]       @relation("TournamentMatchHomeParticipant")
  awayMatches  TournamentMatch[]       @relation("TournamentMatchAwayParticipant")
  wonMatches   TournamentMatch[]       @relation("TournamentMatchWinner")
  matchResults TournamentMatchResult[]

  @@unique([instanceId, userId])
  @@index([instanceId, status])
  @@index([instanceId, points(sort: Desc), wins(sort: Desc)])
  @@index([teamId])
  @@map("tournament_participants")
}

model TournamentRound {
  id          String   @id @default(cuid())
  instanceId  String
  roundNumber Int
  stageKey    String?
  name        String
  status      String   @default("planned") // planned | in_progress | completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instance TournamentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  matches  TournamentMatch[]

  @@unique([instanceId, roundNumber])
  @@index([instanceId, status, roundNumber])
  @@map("tournament_rounds")
}

model TournamentMatch {
  id                  String    @id @default(cuid())
  instanceId          String
  roundId             String?
  matchNumber         Int
  status              String    @default("planned") // planned | in_progress | completed | void
  // Phase: in welchem Turnierabschnitt spielt das Match?
  // 'main' = Standard (Single/Double Elim oder Round Robin),
  // 'group' = Gruppenphase (group_plus_knockout),
  // 'knockout' = KO-Phase nach Gruppenphase.
  phase               String    @default("main")
  // Optionale Gruppenzuordnung (für group_plus_knockout)
  groupLabel          String?
  scheduledAt         DateTime?
  completedAt         DateTime?
  venueLabel          String?
  // Entity-Referenzen: je nach Modus entweder participant ODER team gesetzt
  homeParticipantId   String?
  awayParticipantId   String?
  homeTeamId          String?
  awayTeamId          String?
  // Gewinner: ebenfalls je nach Modus
  winnerParticipantId String?
  winnerTeamId        String?
  isDraw              Boolean   @default(false)
  metadata            Json?
  recordedBy          String?
  // Bracket-Verknüpfungen für Auto-Advance (Bracket-Generator setzt diese Felder).
  nextWinnerMatchId   String?
  nextWinnerSlot      String? // "home" | "away"
  nextLoserMatchId    String?
  nextLoserSlot       String? // "home" | "away"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  instance          TournamentInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  round             TournamentRound?        @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeParticipant   TournamentParticipant?  @relation("TournamentMatchHomeParticipant", fields: [homeParticipantId], references: [id], onDelete: SetNull)
  awayParticipant   TournamentParticipant?  @relation("TournamentMatchAwayParticipant", fields: [awayParticipantId], references: [id], onDelete: SetNull)
  homeTeam          TournamentTeam?         @relation("TournamentMatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam          TournamentTeam?         @relation("TournamentMatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerParticipant TournamentParticipant?  @relation("TournamentMatchWinner", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  winnerTeam        TournamentTeam?         @relation("TournamentMatchWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  recorder          User?                   @relation("TournamentMatchRecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)
  results           TournamentMatchResult[]

  @@index([instanceId, status, matchNumber])
  @@index([instanceId, phase])
  @@index([roundId, matchNumber])
  @@index([scheduledAt])
  @@map("tournament_matches")
}

model TournamentMatchResult {
  id            String   @id @default(cuid())
  matchId       String
  // Ergebnis bezieht sich auf EINE Entity: entweder participant (individual-Mode)
  // oder team (team/pair-Mode). Eins von beiden ist gesetzt, das andere null.
  participantId String?
  teamId        String?
  score         Float    @default(0)
  outcome       String? // win | loss | draw | forfeit
  details       Json?
  createdAt     DateTime @default(now())

  match       TournamentMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant TournamentParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        TournamentTeam?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantId])
  @@unique([matchId, teamId])
  @@index([participantId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@map("tournament_match_results")
}

model GroupFeedPost {
  id          String   @id @default(cuid())
  groupId     String
  createdById String
  contentType String   @default("post")
  title       String?
  body        String
  entityType  String?
  entityId    String?
  imageUrl    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group          Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  savedBy        GroupFeedPostSave[]
  likes          GroupFeedPostLike[]
  historyEntries GroupFeedPostHistory[]
  comments       GroupFeedComment[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model GroupFeedPostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post GroupFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model GroupFeedPostSave {
  userId  String
  postId  String
  savedAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post GroupFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([postId])
}

model GroupFeedPostHistory {
  id               String   @id @default(cuid())
  postId           String
  editedById       String?
  previousTitle    String?
  previousBody     String
  previousMetadata Json?
  createdAt        DateTime @default(now())

  post     GroupFeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  editedBy User?         @relation("GroupFeedPostHistoryEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([postId, createdAt(sort: Desc)])
  @@index([editedById, createdAt(sort: Desc)])
}

model GroupFeedComment {
  id              String    @id @default(cuid())
  postId          String
  groupId         String
  userId          String
  parentCommentId String?
  content         String
  mentions        Json?
  deletedAt       DateTime?
  deletedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post           GroupFeedPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  group          Group                     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment  GroupFeedComment?         @relation("GroupFeedCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies        GroupFeedComment[]        @relation("GroupFeedCommentReplies")
  deletedBy      User?                     @relation("GroupFeedCommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  likes          GroupFeedCommentLike[]
  historyEntries GroupFeedCommentHistory[]

  @@index([postId, parentCommentId, createdAt(sort: Desc)])
  @@index([parentCommentId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc)])
}

model GroupFeedCommentHistory {
  id              String   @id @default(cuid())
  commentId       String
  editedById      String?
  previousContent String
  createdAt       DateTime @default(now())

  comment  GroupFeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  editedBy User?            @relation("GroupFeedCommentHistoryEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([commentId, createdAt(sort: Desc)])
  @@index([editedById, createdAt(sort: Desc)])
}

model GroupFeedCommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment GroupFeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model GroupInvite {
  id               String    @id @default(cuid())
  token            String    @unique
  createdBy        String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  maxUses          Int?
  useCount         Int       @default(0)
  notificationText String?
  isActive         Boolean   @default(true)

  creator User               @relation("GroupInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  groups  GroupInviteGroup[]

  @@index([createdBy])
  @@index([isActive, createdAt(sort: Desc)])
}

model GroupInviteGroup {
  inviteId String
  groupId  String

  invite GroupInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  group  Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([inviteId, groupId])
  @@index([groupId])
}

model GroupMember {
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

model Album {
  id        String   @id @default(cuid())
  name      String
  groupId   String
  createdBy String
  createdAt DateTime @default(now())

  group        Group              @relation(fields: [groupId], references: [id])
  photos       PhotoAlbum[]
  contributors AlbumContributor[]
}

model AlbumContributor {
  albumId String
  userId  String

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([albumId, userId])
}

model Photo {
  id            String   @id @default(cuid())
  uploaderId    String
  groupId       String
  filename      String
  path          String   @unique
  description   String?
  mediaType     String   @default("image")
  videoDuration Int?
  createdAt     DateTime @default(now())

  uploader User         @relation(fields: [uploaderId], references: [id])
  group    Group        @relation(fields: [groupId], references: [id])
  albums   PhotoAlbum[]
  comments Comment[]
  likes    Like[]
}

model PhotoAlbum {
  photoId String
  albumId String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([photoId, albumId])
}

model Comment {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([photoId, userId])
}

model GroupDeputy {
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model GroupBlock {
  groupId       String
  userId        String
  blockedBy     String?
  blockedReason String?
  createdAt     DateTime @default(now())

  group         Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User  @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedByUser User? @relation("BlockedByUser", fields: [blockedBy], references: [id], onDelete: SetNull)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupBackup {
  id            String   @id @default(cuid())
  zipKey        String   @unique
  groupId       String?
  groupName     String
  deletedByName String?
  photoCount    Int      @default(0)
  sizeBytes     BigInt?
  createdAt     DateTime @default(now())
  linkExpiry    DateTime

  @@map("group_backups")
}

model UserExport {
  id            String    @id @default(cuid())
  userId        String
  zipKey        String    @unique
  downloadToken String    @unique
  status        String    @default("queued") // queued | running | ready | failed
  photoCount    Int       @default(0)
  sizeBytes     BigInt?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  readyAt       DateTime?
  linkExpiry    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([linkExpiry])
  @@map("user_exports")
}

model AccountDeletionRequest {
  id              String    @id @default(cuid())
  userId          String    @unique
  codeHash        String
  codeExpiresAt   DateTime
  requestedAt     DateTime  @default(now())
  lastCodeSentAt  DateTime  @default(now())
  confirmAttempts Int       @default(0)
  status          String    @default("pending") // pending | confirmed | reactivated | purged
  keepContent     Boolean?
  successorUserId String?
  confirmedAt     DateTime?
  purgeAt         DateTime?
  reactivatedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, purgeAt])
  @@map("account_deletion_requests")
}

model ChangelogEntry {
  id            String   @id @default(cuid())
  version       String
  title         String
  body          String?
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("changelog_entries")
}

model AdminActionLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  actionType  String   @map("action_type")
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType, createdAt(sort: Desc)])
  @@map("admin_action_logs")
}

model BlockedLoginIdentity {
  id              String   @id @default(cuid())
  email           String
  emailNormalized String   @map("email_normalized")
  authSource      String   @map("auth_source")
  reason          String
  blockedByUserId String?  @map("blocked_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  blockedByUser User? @relation("BlockedLoginIdentityBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)

  @@unique([emailNormalized, authSource])
  @@index([createdAt(sort: Desc)])
  @@map("blocked_login_identities")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String // deputyAdded | deputyRemoved | contributorAdded | contributorRemoved | groupMemberJoined | groupMemberLeft | groupDeleted | photoLiked | photoCommented | feedPostLiked | feedPostCommented | feedCommentMentioned | feedCommentReplied | feedCommentLiked | newPhoto | newAlbum
  title      String
  body       String
  entityId   String? // ID des betroffenen Objekts (Photo, Group, Album...)
  entityType String? // "group" | "photo" | "album" | "external"
  imageUrl   String? // Optionale Bild-URL für Vorschau in der Benachrichtigung
  entityUrl  String? // Optionale externe URL für Navigation
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  userId String @id

  // In-App Einstellungen
  inApp_deputyAdded          Boolean @default(true)
  inApp_deputyRemoved        Boolean @default(true)
  inApp_contributorAdded     Boolean @default(true)
  inApp_contributorRemoved   Boolean @default(true)
  inApp_groupMemberJoined    Boolean @default(true)
  inApp_groupMemberLeft      Boolean @default(true)
  inApp_groupDeleted         Boolean @default(true)
  inApp_photoLiked           Boolean @default(true)
  inApp_photoCommented       Boolean @default(true)
  inApp_feedPostLiked        Boolean @default(true)
  inApp_feedPostCommented    Boolean @default(true)
  inApp_feedCommentMentioned Boolean @default(true)
  inApp_feedCommentReplied   Boolean @default(true)
  inApp_feedCommentLiked     Boolean @default(true)
  inApp_newPhoto             Boolean @default(true)
  inApp_newAlbum             Boolean @default(true)
  inApp_system               Boolean @default(true)

  // E-Mail Einstellungen
  email_deputyAdded          Boolean @default(true)
  email_deputyRemoved        Boolean @default(false)
  email_contributorAdded     Boolean @default(true)
  email_contributorRemoved   Boolean @default(false)
  email_groupMemberJoined    Boolean @default(false)
  email_groupMemberLeft      Boolean @default(false)
  email_groupDeleted         Boolean @default(true)
  email_photoLiked           Boolean @default(false)
  email_photoCommented       Boolean @default(false)
  email_feedPostLiked        Boolean @default(false)
  email_feedPostCommented    Boolean @default(false)
  email_feedCommentMentioned Boolean @default(false)
  email_feedCommentReplied   Boolean @default(false)
  email_feedCommentLiked     Boolean @default(false)
  email_newPhoto             Boolean @default(false)
  email_newAlbum             Boolean @default(false)
  email_system               Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedbackReport {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          String // "bug" | "feature" | "help" | "report_user" | "other"
  subject           String
  body              String
  anonymous         Boolean  @default(false)
  reportedUserId    String?
  reportedUser      User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  status            String   @default("open") // "open" | "closed" | "accepted" | "rejected"
  waitingFor        String   @default("support") // "support" | "user" | "none"
  unreadAdmin       Boolean  @default(true)
  unreadUser        Boolean  @default(false)
  resolution        String? // "no_action" | "action_taken" — nur für report_user
  githubIssueNumber Int?
  githubIssueUrl    String?
  createdAt         DateTime @default(now())

  messages FeedbackMessage[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("feedback_reports")
}

model FeedbackMessage {
  id        String         @id @default(cuid())
  reportId  String
  report    FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([reportId])
  @@map("feedback_messages")
}
